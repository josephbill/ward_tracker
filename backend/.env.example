# Copy to .env and fill in only what you actually have — every value below
# has a working stub/dummy default, so the backend runs fully without this
# file. See README.md "What's real vs stubbed" for details.

# --- Dispute aggregation / spam-defense thresholds (Section 5 & 6) ---
DISPUTE_THRESHOLD_COUNT=3
DISPUTE_INDEPENDENCE_RADIUS_M=500
CONFIRMATION_THRESHOLD_COUNT=2
REPORT_EDIT_WINDOW_HOURS=24
BURST_MAX_REPORTS=5
BURST_WINDOW_MINUTES=10
NEW_NUMBER_MULTI_WARD_THRESHOLD=3
PHONE_HASH_SALT=change-this-to-a-real-secret-in-any-real-deployment

# --- Ledger: "stub" (default, no creds needed) or "hedera_sidecar" ---
LEDGER_BACKEND=stub
LEDGER_SIDECAR_URL=http://localhost:4001

# --- WhatsApp: "dummy" (default, logs only) or "twilio" ---
WHATSAPP_BACKEND=dummy
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- SMS: "dummy" (default, logs only) or "africas_talking" ---
SMS_BACKEND=dummy
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SHORTCODE=

# --- STT (voice-to-text, native path only): "dummy" or "openai_whisper" ---
STT_BACKEND=dummy
OPENAI_API_KEY=

# --- Email notifications (SendByte, https://docs.sendbyte.africa/):
# "dummy" (default, logs only) or "sendbyte". Sandbox keys start sk_test_ —
# no domain verification needed, emails show up in SendByte's own dashboard
# without being actually delivered. Fires whenever a report or issue is
# captured — see app/services/notifications.py.
EMAIL_BACKEND=dummy
SENDBYTE_API_KEY=
SENDBYTE_FROM_ADDRESS=reports@wardtracker.ng
COUNTY_NOTIFICATION_EMAIL=josephbill00@gmail.com

# --- Cloud deployment (e.g. Pxxl) ---
# PORT is normally set by the platform itself, not here.
FLASK_DEBUG=false

DATABASE_URL=
