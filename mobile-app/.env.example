# Copy to .env and fill in what you have — the app runs fully without this
# file (backend defaults to http://localhost:5055, analytics stays inert).

# Backend URL. Defaults to http://localhost:5055 (web/iOS simulator).
# On a physical device use your machine's LAN IP; on the Android emulator
# use http://10.0.2.2:5055 to reach the host's localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5055

# Sabilytics (https://www.sabilytics.com/) — web-only analytics, see
# docs/ARCHITECTURE.md. Leave unset to keep trackEvent() fully inert.
EXPO_PUBLIC_SABILYTICS_SITE_ID=
EXPO_PUBLIC_SABILYTICS_DOMAIN=
EXPO_PUBLIC_SABILYTICS_SCRIPT_URL=
